{
  "info": {
    "name": "Inventory API - Sprint 1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "US-1 Add product - success",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"sku\", \"pm-\" + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
              "const j = pm.response.json();",
              "pm.test(\"has id and normalised sku\", () => { pm.expect(j.id).to.be.a(\"number\"); pm.expect(j.sku).to.eql(pm.variables.get(\"sku\").toUpperCase()); });",
              "pm.collectionVariables.set(\"productId\", j.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Postman Item\",\"sku\":\"{{sku}}\",\"price\":99.5,\"quantity\":10,\"category\":\"Test\"}"
        }
      }
    },
    {
      "name": "US-1 Add product - validation error",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"400 Bad Request\", () => pm.response.to.have.status(400));",
              "pm.test(\"details returned\", () => pm.expect(pm.response.json().details).to.be.an(\"array\").that.is.not.empty);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": [
            "{{baseUrl}}"
          ],
